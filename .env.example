# عنوان ومنفذ التشغيل
HOST=0.0.0.0
PORT=5050

# وضع إعادة التحميل التلقائي عند تعديل الكود (للتطوير المحلي فقط، اتركه false بالإنتاج)
RELOAD=false

# مفتاح حماية API — اتركه فارغًا للتطوير المحلي.
# عند النشر على سيرفر عام، عيّن قيمة عشوائية قوية هنا، وأرسل نفس القيمة
# من العميل برأس الطلب: X-API-Key
API_KEY=

# أصول CORS المسموح لها بالوصول للـAPI، مفصولة بفواصل (* يعني الكل)
CORS_ORIGINS=*

# اسم موديل XTTS المستخدم للاستنساخ الصوتي
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
